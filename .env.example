# ConfigSentinel - Environment Variables Example
# --------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to Git.

# --- App ---
APP_ENV=development
DEMO_MODE=true

# --- Security ---
SECRET_KEY=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120

# --- Database ---
# SQLite (default, local/dev):
DATABASE_URL=sqlite:///./configsentinel.db
# PostgreSQL (production example):
# DATABASE_URL=postgresql://username:password@host:5432/configsentinel

# --- AI (Anthropic Claude) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL=claude-sonnet-4-6

# --- AWS ---
AWS_REGION=ap-south-1
EC2_HOST=your-ec2-public-ip-or-dns
EC2_SSH_USER=ec2-user
EC2_SSH_KEY_PATH=/path/to/your-key.pem
CLOUDWATCH_NAMESPACE=ConfigSentinel
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are intentionally NOT listed here.
# Use `aws configure`, an IAM role, or CI/CD secrets instead - never hardcode keys.

# --- Ansible ---
ANSIBLE_INVENTORY_PATH=../ansible/inventory
ANSIBLE_PLAYBOOK_PATH=../ansible/remediation.yml

# --- Desired state file ---
DESIRED_STATE_PATH=./demo/desired_state.yaml
