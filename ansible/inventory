# ConfigSentinel - Ansible Inventory
# ---------------------------------------
# Replace with your real EC2 host once provisioned via Terraform.
# The IP/DNS below normally matches the `instance_public_ip` Terraform output.

[configsentinel_servers]
monitored_server ansible_host=YOUR_EC2_PUBLIC_IP ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/your-key.pem

[configsentinel_servers:vars]
ansible_python_interpreter=/usr/bin/python3
